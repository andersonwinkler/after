    "thal":           {"lowres": "mri/ThalamicNuclei.FSvoxelSpace.mgz",              "highres": "mri/ThalamicNuclei.mgz",              "stats": ["mri/ThalamicNuclei.volumes.txt"],                                 "cols":[null, 0, 1]},
    "limbic":         {"lowres": "mri/sclimbic.mgz",                                 "highres": null,                                  "stats": ["stats/sclimbic.stats"],                                           "cols":[   1, 4, 3]},
